{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-request.schema.json",
  "title": "StrategyRequest",
  "description": "Request to the authentic Strategic Engine: markets + capital -> allocation + recommendations.",
  "type": "object",
  "required": ["markets", "mode"],
  "properties": {
    "markets": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "required": ["marketId", "capitalUsd"],
        "properties": {
          "marketId": { "$ref": "common.schema.json#/$defs/MarketRef" },
          "capitalUsd": { "$ref": "common.schema.json#/$defs/Usd" },
          "flowScale": { "type": "number", "minimum": 0 },
          "ringsActive": { "type": "integer", "minimum": 0, "maximum": 6 },
          "stage": { "$ref": "common.schema.json#/$defs/StageId" },
          "token": { "$ref": "token-ref.schema.json" }
        },
        "additionalProperties": false
      }
    },
    "hurdleBps": { "type": "number", "minimum": 0 },
    "mode": { "enum": ["SIMULATION", "REPLAY"] }
  },
  "additionalProperties": false
}
