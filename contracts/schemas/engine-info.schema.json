{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine-info.schema.json",
  "title": "EngineInfo",
  "description": "Result of the 'info' handshake. contractVersion major must match Titan Forge's.",
  "type": "object",
  "required": ["id", "label", "authentic", "contractVersion", "methods"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 200 },
    "authentic": { "type": "boolean" },
    "version": { "type": "string" },
    "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "methods": { "type": "array", "items": { "enum": ["info", "health", "quote", "strategy"] } }
  },
  "additionalProperties": false
}
