# Titan Forge — environment variables (example). NO SECRETS IN THIS FILE OR IN GIT.
# The server reads process env only (it does not load .env files). Export variables in the shell or the service unit.
# Values below are empty or safe demo defaults.

# ---------- Core server ----------
PORT=4131                          # HTTP port (binds 127.0.0.1 only)
TF_READONLY=                       # 1 = Ledger.submit() throws; mandatory for private test servers
TF_OFFLINE=                        # 1 = offline replay: no network, no signing, recorded data shown as REPLAY
TF_BOOTSTRAP_RETRY_MS=30000        # Testnet bootstrap retry interval; 0 disables
TF_ENGINE_BIN=                     # optional Rust engine binary (lib/engine)
TF_ENGINE_URL=                     # optional Rust engine URL (lib/engine)

# ---------- Access / x402 ----------
FREE_LIQUIDITY_THRESHOLD_USD=50000 # demo default, not approved
TF_ACCESS_XRP_USD=                 # XRP/USD used for threshold math and the TG Merchant intent estimate
TF_ACCESS_GRACE_HOURS=             # grace period after threshold crossing

# ---------- Data files (optional overrides) ----------
TF_ARENA_FILE=
TF_CORRIDOR_FILE=
TF_FINDINGS_FILE=
TF_SPOKES_FILE=
TF_SPOKES_REFRESH_MIN=30
TF_SPOKES_MIN_GAP_SEC=
TF_SPOKES_LEDGERS=
TF_SPOKES_AUTO=                    # 0 disables auto refresh
TF_INCUBATOR_FILE=
TF_TGAN_FILE=
TF_LOOP_FILE=
TF_VENDOR_SAMPLES_FILE=            # default data/vendor-samples.json (verified probe output, no secrets)

# ---------- Vendor integrations (docs/VENDOR_INTEGRATION_MATRIX.md) ----------
# QuickNode — managed XRPL endpoint + Streams. Read-only methods only. Leave empty to use public nodes.
QUICKNODE_XRPL_HTTP=               # https://<name>.xrp-mainnet.quiknode.pro/<token>/  (token is in the URL: secret)
QUICKNODE_XRPL_WSS=                # wss://<name>.xrp-mainnet.quiknode.pro/<token>/    (secret)
QUICKNODE_STREAMS_KEY=             # Streams REST API key (header x-api-key); used only for GET /streams (secret)

# AWS Bedrock AgentCore — presence is detected only; this node makes no AWS call yet.
AWS_ACCESS_KEY_ID=                 # secret; prefer AWS_PROFILE / SSO instead of static keys
AWS_SECRET_ACCESS_KEY=             # secret
AWS_PROFILE=                       # named profile with AgentCore Gateway permissions
AWS_REGION=                        # region where the AgentCore Gateway would be created
AGENTCORE_GATEWAY_URL=             # Gateway MCP endpoint once deployed (not used yet)

# Mastercard Agent Pay (AP4M) — early-access sandbox. DOCUMENTATION_ONLY: no call is made even when set.
MASTERCARD_CONSUMER_KEY=           # from developer.mastercard.com project (secret)
MASTERCARD_SIGNING_KEY_PATH=       # path to the .p12 signing key, outside the repo, chmod 600 (secret file)
MASTERCARD_SIGNING_KEY_ALIAS=      # key alias inside the .p12
MASTERCARD_SIGNING_KEY_PASSWORD=   # .p12 password (secret)
MASTERCARD_ENV=sandbox             # sandbox only; never production from this node

# Ledger, t54 and XRPL need no credentials (browser WebHID; public read-only /supported; public XRPL nodes).
